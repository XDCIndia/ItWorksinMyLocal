# seat.env.sample — every parameter the seat-net/ scripts read, documented.
#
# Copy to seat.env and fill in for your net (never commit seat.env — see
# .gitignore). NO defaults here are secrets; OWNER_KEY_FILE POINTS AT a key
# file, it is never a literal key.
#
#   cp seat.env.sample seat.env
#   vim seat.env       # fill in RPCs, ports, coinbase, OWNER_KEY_FILE path
#   set -a; source seat.env; set +a
#   ./seat-window.sh

# ---------------------------------------------------------------------------
# Network topology
# ---------------------------------------------------------------------------

# Comma-separated JSON-RPC URLs of >=2 SEATED legacy arbiters (the reference
# set every gate/preflight check measures against). These must never be the
# candidate and must never be stopped by any script in this directory.
RPC_ARBITERS=http://127.0.0.1:37421,http://127.0.0.1:37422

# JSON-RPC URL of an INDEPENDENT observer node — NOT seated, NOT the
# candidate, NOT one of RPC_ARBITERS. Used only for cross-checking hash
# agreement / attribution from a third vantage point.
RPC_OBSERVER=http://127.0.0.1:37496

# JSON-RPC URL of the candidate client itself. Read-only cross-checks (tip
# lag, etc.) may query it, but per the protocol its OWN HEAD IS NEVER AN
# ADMISSIBLE ATTRIBUTION SOURCE (gate-mint.sh enforces this in code).
RPC_CANDIDATE=http://127.0.0.1:37486

# Candidate's P2P/RPC ports, used only for `ss -ltnp "sport = :PORT"` pid
# lookup in relaunch-producer.sh / abort.sh — NEVER for a pgrep-on-datadir
# pattern (see README: that can match the caller's own shell).
CANDIDATE_P2P_PORT=37481
CANDIDATE_RPC_PORT=37486

# One of: geth | erigon | reth  (erigon/reth are reference-only families;
# neither should currently be relaunched under this playbook — see
# docs/client-readiness.md). "geth" also covers the xone ethcompat build,
# which is geth-lineage.
CANDIDATE_FAMILY=geth

# Candidate's coinbase / signer address (0x..., 20 bytes).
CANDIDATE_COINBASE=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# Onboarding (owner != candidate split — see onboard-net/onboard.py)
# ---------------------------------------------------------------------------

# Path to a file containing ONLY the owner/payer private key (hex, no 0x, no
# trailing newline needed). NEVER put the key literally in this file. Scripts
# read this file into an env var for a single subprocess and never log it.
OWNER_KEY_FILE=/path/to/owner.key

# The candidate/coinbase address that gets proposed (usually == CANDIDATE_COINBASE).
CAND=0x0000000000000000000000000000000000000000

CHAIN_ID=34093
EPOCH=900
GAP=450

# Height at/after which blocks are recovered with V2 (HotStuff) signer rules
# instead of V1 (Clique-style extraData-tail seal). Get this wrong and every
# post-switch block silently misreports in measure-share.py / gate-mint.sh.
# Leave unset (or huge) on a V1-only net.
V2SWITCH_BLOCK=1800
SMC=0x0000000000000000000000000000000000000088
DEPOSIT_WEI=10000000000000000000000
GAS_PRICE=250000000

# Minimum blocks of margin required between the propose receipt's block and
# the gap block (C - GAP). Never aim at the last few blocks of a window.
SAFETY_MARGIN_BLOCKS=100

# ---------------------------------------------------------------------------
# preflight.sh extras
# ---------------------------------------------------------------------------

# Path to the candidate's own stdout/log file (assert_no_validation_bypass +
# the SkipV1Validation check read this).
CANDIDATE_LOG=/path/to/candidate/node.log

# Path to the net's genesis.json. Used as the fallback source for the
# SkipV1Validation check when the candidate's own log never prints that
# startup banner line (true of every geth-lineage client, e.g. xone) --
# reads config.XDPoS.skipV1Validation directly, same source gate-erigon.sh
# already trusts.
GENESIS_FILE=/path/to/genesis.json

# sha256 of the binary you PROVED in Phase 0 -- preflight.sh refuses to
# auto-pass the binary-fingerprint check without this (the check that would
# have caught the xone native-vs-ethcompat two-binary swap).
EXPECTED_BINARY_FINGERPRINT=

# Configured XDPoS block period, seconds/block (for wall-clock estimates only
# — every real gate is measured from block TIMESTAMPS, never poll wall-clock).
PERIOD_SECS=2
