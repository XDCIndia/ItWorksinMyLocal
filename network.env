# Default network target for join.sh (override with --ip / --bootnodes / --genesis).
#
# This points at XDC devnet 5151 (cross-client mainnet-parity devnet). With these
# defaults, a plain `./join.sh` (or `./join.sh --client geth|erigon`) syncs 5151
# with no extra flags.
DEFAULT_HOST=65.21.71.4
DEFAULT_BOOTNODE_PORT=30551

# Genesis used when --genesis is not passed.
DEFAULT_GENESIS=genesis/genesis-5151.json

# The 5151 masternode enodes are on four separate hosts (no single-host bootnode),
# so dial them directly. join.sh uses DEFAULT_BOOTNODES verbatim when no
# --bootnodes/--ip is given, instead of deriving one from bootnode.key.
DEFAULT_BOOTNODES="enode://4e0da440445f6db31dabc7f4b5629fa250b1c974f12f398b8ba980f34cd480d7987996044127cc64f7120569bc21bf889ed8d71e8afe4d979b61e5dd09e38a7d@65.21.71.4:30551,enode://962f25f72e962649f1aa079839eb32bc2a32cb6ebf261c148388c38d9cf0aab545533901fba62e06d950377cc92a348b312b84ce53f70d5852527f81ac7d2e46@65.21.27.213:30551,enode://7507c2789f2b21c8ecf52f3b9d2ca561d1ee7686d7e55ad2e974e76fcad706569599dd86d53097fe71b968e667168099ada8e953e43a84443c0780b8ca97ed7c@95.217.112.125:30551,enode://dd25c6f269d6fc9883e04d25e095358dbf295f657028cea3e8e7dc00faac45b33495a0ddc82d4b5f9a705688c091cf85062a55e6bce479e9d07f68d837e98376@135.181.117.109:30551"
