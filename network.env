# Default network target for join.sh (override with --ip / --bootnodes / --genesis).
#
# This points at XDC devnet 5151 (cross-client mainnet-parity devnet). With these
# defaults, a plain `./join.sh` (or `./join.sh --client geth|erigon`) syncs 5151
# with no extra flags.
#
# NETWORK STATE (rebuilt 2026-07-20): fresh genesis, hash
#   0x51b4dfba5f2efc173c4ba2c41a83f47cbb5dfcdc6d6fba732a36817330f860de
# Consensus: XDPoS v2 (period 2s, epoch 900, gap 450, V1->V2 switch @1800),
#   eip1559 @2250 (fixed base fee 12.5 gwei), cancun @3150. chainId 5151.
# Active minting masternodes (4): 0xc266bf3d, 0x04493684, 0x315343a4, 0x54037fb7.
DEFAULT_HOST=65.21.71.4
DEFAULT_BOOTNODE_PORT=30551

# Genesis used when --genesis is not passed.
DEFAULT_GENESIS=genesis/genesis-5151.json

# The 5151 masternode enodes are on three separate hosts (no single-host bootnode),
# so dial them directly. join.sh uses DEFAULT_BOOTNODES verbatim when no
# --bootnodes/--ip is given, instead of deriving one from bootnode.key.
# Refreshed 2026-07-20 after the fresh-genesis rebuild (all pre-rebuild enodes are dead).
DEFAULT_BOOTNODES="enode://dde065ebbf33c4fc597163501d86049702ac9ef201b9db36f8dcf83b65736987d141e245a6542aff4a82bf3bf2a0f7704a170677161753d6ceaae6fe9017f780@65.21.71.4:30551,enode://6d28f403d8d43d45d6c277ffaec60af02b99778579851babad5a6759812631b6c7cfb3ca912c5aad1a7da041db2b2b899dad9606c5341502dd0b576383e36e8a@65.21.27.213:30551,enode://068af1d174420dcfff329df79edfc63643eba2806bf4bbc9080f4f11e89829838c88fff2d193d91aa90e6c066cf4ceeff88d5b15838ae2d07156dbb5f82ed9f9@95.217.112.125:30551,enode://d80c1709b694c600eca321e43f92f79f528e47732973b0b15dfef660a2c80469518b08205009cd1c686aa28ba63c7dba4e0fba49470be5f2612a185461724aa5@65.21.71.4:30553,enode://9c044b620ece948721bc0e55c0198277b6e82d4898856dfa613216c225cdb7576350c899461ec6c4006ccc69646c224bfb48046f1f9a0a3a344348df21109f58@65.21.71.4:30756,enode://10582b343a6fa09f18f5b03d426a9c598614e08e29c4d48cc52b6c43336c82e91755045018d2fa14b850f1172b7a578dfe2f9a79ff40a24cfe57abf6623a178a@95.217.112.125:30552"
